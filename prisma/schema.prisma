generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum SocialChannel {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  LINKEDIN
}

enum ProjectType {
  COMPANY
  PERSONAL_BRAND
  PROFESSIONAL
  CAMPAIGN
  OTHER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  posts        Post[]
  projects     Project[]
}

model Project {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  type        ProjectType @default(OTHER)
  avatarUrl   String?
  description String?
  accentColor String?
  isActive    Boolean     @default(true)
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts       Post[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId, isActive])
}

model Post {
  id          String        @id @default(cuid())
  title       String
  content     String
  scheduledAt DateTime?
  status      PostStatus    @default(DRAFT)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  // NoAction: impede apagar um projeto que ainda tem posts, mas permite o
  // cascade de User -> Project/Post (a checagem ocorre ao fim do statement).
  project     Project       @relation(fields: [projectId], references: [id], onDelete: NoAction)
  channels    PostChannel[]
  mediaUrls   String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([scheduledAt])
}

model PostChannel {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel   SocialChannel
  createdAt DateTime      @default(now())

  @@unique([postId, channel])
  @@index([channel])
}
