# =============================================================================
# PostgreSQL LOCAL — Prisma Dev (recomendado no Windows, sem Docker)
# =============================================================================
#   npm run db:dev:up
#   npm run db:setup
#   npm run dev
#
# O script db:dev:up sobe o Postgres embarcado e preenche DATABASE_URL/DIRECT_URL no .env.
# DATABASE_URL usa pgbouncer=true (app); DIRECT_URL é conexão direta (db push/migrate).

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:PORT/nucleu_omnis_agenda?schema=public&sslmode=disable&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:PORT/nucleu_omnis_agenda?schema=public&sslmode=disable"

# =============================================================================
# PostgreSQL LOCAL (instalação nativa)
# =============================================================================
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/nucleu_omnis_agenda?schema=public"
# DIRECT_URL="postgresql://postgres:SUA_SENHA@localhost:5432/nucleu_omnis_agenda?schema=public"

# =============================================================================
# Docker (opcional — só se você preferir)
# =============================================================================
#   npm run db:local:up
#   npm run db:setup
#
# Usa postgres/postgres e o banco nucleu_omnis_agenda (ver docker-compose.yml).

# =============================================================================
# Supabase (fase seguinte / remoto)
# =============================================================================
# Project Settings → Database → Connection string (URI)
#
# App (pooler, porta 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@....pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Migrations (direto, porta 5432):
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@....pooler.supabase.com:5432/postgres"

# =============================================================================
# Aplicação
# =============================================================================

OPENAI_API_KEY="sk-..."

NEXTAUTH_SECRET="substitua-por-um-segredo-com-pelo-menos-32-caracteres"

# DEFAULT_USER_ID=""
